1461855.jpg"},{"s":3,"e":17,"t":"Anywhere in the Wide World","a":"1972-01-26","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462060.jpg"},{"s":3,"e":18,"t":"Flight","a":"1972-02-02","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462061.jpg"},{"s":3,"e":19,"t":"The Big Tip-Off","a":"1972-02-09","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462062.jpg"},{"s":3,"e":20,"t":"Woman's World","a":"1972-02-16","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462063.jpg"},{"s":3,"e":21,"t":"A Policeman's Lot: Part 1: The Row on the Stairs","a":"1972-02-23","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462073.jpg"},{"s":3,"e":22,"t":"A Policeman's Lot: Part 2: You Pays Your Money","a":"1972-03-01","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462074.jpg"},{"s":3,"e":23,"t":"A Policeman's Lot: Part 3: It Depends Where You're Standing","a":"1972-03-08","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462077.jpg"},{"s":3,"e":24,"t":"Set Us Alight","a":"1972-03-15","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462082.jpg"},{"s":3,"e":25,"t":"The Easy Job","a":"1972-03-22","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462083.jpg"},{"s":3,"e":26,"t":"Conclusion","a":"1972-03-29","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462085.jpg"},{"s":4,"e":1,"t":"Spit and Polish","a":"1972-09-13","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462090.jpg"},{"s":4,"e":2,"t":"Killer","a":"1972-09-20","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/584/1462055.jpg"},{"s":4,"e":3,"t":"Surveillance","a":"1972-09-27","l":60,"img":"https://static.tvmaze.com/uploads/images/original_untouched/585/1462884.jpg"},{"s":4,"e":4,"t":"